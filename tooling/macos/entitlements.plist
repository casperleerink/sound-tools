<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Recording from the default input of macOS. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- CLAP and VST 3 plugins of other makers are signed by them, not by us, and must load. -->
	<key>com.apple.security.cs.disable-library-validation</key>
	<true/>
	<!-- Code written at run time. Without them the hardened runtime makes Bun fall back to its
	     interpreter, about seven times slower, and plugins that compile their DSP fail. -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
